# Postgres connection string. Used when running the app natively (npm run dev).
# Under `docker compose up`, this is overridden to reach the postgres container.
DATABASE_URL=postgres://finance:finance@localhost:5433/finance

# Plaid credentials (from the Plaid dashboard).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
PLAID_WEBHOOK_URL=           # public URL for /api/plaid/webhook (use a tunnel in dev)
PLAID_REDIRECT_URI=          # registered OAuth redirect URI, e.g. https://<tunnel>/connections (prod OAuth banks)

# 32-byte key (base64-encoded) for AES-256-GCM encryption of Plaid access tokens.
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# Single-user app; cosmetic only.
APP_OWNER_NAME=

# Local AI (Ollama) — free and on-device. Used when running natively.
# Under `docker compose --profile ai up`, this is overridden to the ollama container.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-coder:7b     # try qwen2.5:7b or llama3.1:8b for better tool-use
AI_API_KEY=ollama             # placeholder; Ollama ignores it
