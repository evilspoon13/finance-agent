# Postgres connection string. Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgres://finance:finance@localhost:5433/finance

# Plaid credentials (from the Plaid dashboard).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
PLAID_WEBHOOK_URL=           # public URL for /api/plaid/webhook (use a tunnel in dev)

# 32-byte key (base64-encoded) for AES-256-GCM encryption of Plaid access tokens.
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# Single-user app; cosmetic only.
APP_OWNER_NAME=
