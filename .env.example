# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string. Local default matches docker-compose.yml (which
# overrides it inside the app container). For a hosted DB (e.g. Neon), use the
# pooled URL here and the direct URL in DATABASE_URL_UNPOOLED (migrations).
DATABASE_URL=postgres://finance:finance@localhost:5433/finance
DATABASE_URL_UNPOOLED=

# 32-byte key (base64) that encrypts Plaid access tokens at rest.
# Generate with: openssl rand -base64 32
# Keep it with your data: a database restored under a different key can't
# decrypt its tokens, and every bank would need re-linking.
TOKEN_ENC_KEY=

# ── Login (single user) ───────────────────────────────────────────────────
AUTH_USERNAME=
AUTH_PASSWORD=               # at least 12 characters
AUTH_SECRET=                 # openssl rand -base64 32 (signs session cookies)

# ── Plaid (https://dashboard.plaid.com) ───────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
PLAID_WEBHOOK_URL=           # https://<your-app>/api/plaid/webhook (needs a public URL)
PLAID_REDIRECT_URI=          # https://<your-app>/connections (OAuth banks; allowlist it in Plaid)

# ── Scheduled sync (optional) ─────────────────────────────────────────────
# Bearer token for POST /api/cron/sync. Leave empty to disable the endpoint.
CRON_SECRET=

# ── Finance agent (optional, see docs/agent.md) ───────────────────────────
AGENT_TOKEN=                 # openssl rand -hex 32; bearer token for /api/agent/*
DATABASE_URL_READONLY=       # direct (non-pooled) URL for a read-only role
DISCORD_WEBHOOK_URL=         # channel webhook the agent's alerts are posted to
